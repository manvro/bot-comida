# Puerto en el que escucha el servidor Express.
# En local: 3000. En Railway: lo asigna la plataforma vía $PORT (no fijar).
PORT=3000

# API key de Anthropic, usada por el fallback de Claude (modelo claude-haiku-4-5).
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Secreto para firmar/verificar los JWT del login del panel (middleware/auth.js).
# OBLIGATORIO en producción: si no se setea, usa un fallback inseguro y cualquiera
# podría forjar tokens. Generar una cadena larga y aleatoria (>= 32 chars), p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# (LEGACY) Token compartido para autenticar /admin/* y /api/*. Reemplazado por el
# login con JWT (JWT_SECRET + tabla users). Se conserva por compatibilidad; los
# endpoints del panel ya usan requireAuth, no este token.
ADMIN_TOKEN=

# Credenciales de Twilio. Account SID y Auth Token aparecen en el dashboard:
# https://console.twilio.com/  (Account Info, abajo a la izquierda)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Número de WhatsApp asociado al sandbox (o número productivo aprobado).
# Sandbox compartido de Twilio: +14155238886
# Productivo: tu número WhatsApp Business aprobado.
TWILIO_WHATSAPP_NUMBER=

# URL pública del webhook de Twilio (requerida para validar firma).
# Ejemplo: https://tu-bot.up.railway.app/webhook
WEBHOOK_URL=